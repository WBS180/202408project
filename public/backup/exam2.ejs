<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- PyScript CSS -->
    <link rel="stylesheet" href="https://pyscript.net/latest/pyscript.css">
    <title>예시</title>
    <link rel="stylesheet" href="public/css/exam.css" />
</head>
<body>
    <header>
        <h1>秋收 勞補(추수 로보)</h1>
        <p>로봇팔이 망에 걸려있는 과일을 수확합니다.</p>
    </header>
    <div class="WCDB">
        <div class="webcam">
            <h1>usb 카메라</h1>
            <video id="cameraview" width="640" height="480"></video>
            <canvas id="canvas" width="640" height="480"></canvas>
        </div>
        <div class="DBoutput">
            <table>
                <tr>
                    <th>id</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>초록사과</th>
                    <th>빨간사과</th>
                    <th>귤</th>
                    <th>초록고추</th>
                    <th>빨간고추</th>
                    <th>복숭아</th>
                </tr>
                <% data.forEach(function(row) { %>
                <tr>
                    <td><%= row.id %></td>
                    <td><%= row.date %></td>
                    <td><%= row.time %></td>
                    <td><%= row.apple_green %></td>
                    <td><%= row.apple_red %></td>
                    <td><%= row.orange %></td>
                    <td><%= row.pepper_red %></td>
                    <td><%= row.pepper_green %></td>
                    <td><%= row.peach %></td>
                </tr>
                <% }); %>
            </table>
        </div>
    </div>
    <div class="ECMU">
        <div class="esp32cam">
            <h1>esp32 cam</h1>
            <img src="image/mountain-g98f3ac1ab_1920.jpg" alt="임시 이미지">
        </div>
        <section>
            <form id="harvest-form" class="menu">
                과일종류<select name="fruit" id="fruit-select">
                    <option value="apple_green">초록사과</option>
                    <option value="apple_red">빨간사과</option>
                    <option value="orange">귤</option>
                    <option value="pepper_red">빨간고추</option>
                    <option value="pepper_green">초록고추</option>
                    <option value="peach">복숭아</option>
                </select>
                숫자:<input type="text" id="fruit-quantity" placeholder=".. 개">
                <div class="harvest-button">
                    <form>
                        <input type="submit" value="수확하기">
                    </form>
                </div>
            </form>
        </section>
    </div>
    <!-- PyScript -->
    <script defer src="https://pyscript.net/latest/pyscript.js"></script>
    <!-- Custom JavaScript -->
    <script defer src="js/script.js"></script>
    <!-- PyScript Code -->
    <py-script src="js/Object_Detect_WebCam.py"></py-script>
    <!-- Load OpenCV -->
    <py-script>
        import pyodide
        async def setup():
            await pyodide.loadPackage("opencv-python")
        await setup()
    </py-script>
</body>
</html>
